# Copie ce fichier en .env.local (en local) ou colle ces variables dans
# Vercel > Project > Settings > Environment Variables.

# Adresse publique du site (sans / à la fin)
NEXT_PUBLIC_SITE_URL=https://airge.agency

# Contacts affichés sur le site
NEXT_PUBLIC_WHATSAPP=2376XXXXXXXX
NEXT_PUBLIC_CONTACT_EMAIL=contact@airge.agency
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@ton-compte
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/ton-compte
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/ta-page

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Notch Pay (business.notchpay.co > Paramètres > Développeur)
# Clé de test (pk_test....) pour essayer, puis clé live (pk....) pour vendre.
NOTCHPAY_PUBLIC_KEY=pk_test.xxx
# Clé de hachage des webhooks (facultative mais recommandée)
NOTCHPAY_HASH_KEY=

# Bunny Stream (Stream > ta librairie > API / Security)
BUNNY_STREAM_LIBRARY_ID=123456
BUNNY_STREAM_TOKEN_KEY=

# Emails autorisés à voir le tableau de bord /admin (séparés par des virgules)
ADMIN_EMAILS=ton-email@exemple.com
